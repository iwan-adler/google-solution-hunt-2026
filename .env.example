# SRM Orbit Environment Variables

# Gemini API Key (Server-side only)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Server-side or Public Client where appropriate)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Demo Mode Configuration (Defaults to true for 100% demo reliability without external dependencies)
NEXT_PUBLIC_DEMO_MODE=true

# Google Maps Platform Demo API Key (Optional client-side display)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
